                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "if (res.data?._id) pm.collectionVariables.set('productId', res.data._id);",
                  "pm.test('price is a number', () =>",
                  "  pm.expect(typeof res.data.defaultUnitPrice).to.eql('number'));",
                  "pm.test('uid assigned', () => pm.expect(res.data.uid).to.match(/^PRD-\\d{7}$/));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
