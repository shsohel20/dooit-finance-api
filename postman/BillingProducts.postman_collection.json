        {
          "name": "Bulk import — full 22-product catalogue",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "console.log('created', d.created, 'updated', d.updated, 'failed', d.failed.length);",
                  "pm.test('no row failures', () => pm.expect(d.failed).to.have.lengthOf(0));",
                  "pm.test('22 rows processed', () =>",
                  "  pm.expect(d.created + d.updated).to.eql(22));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "disabled": false
              }
            ],
            "body": {
