          "name": "List products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('has pagination', () => pm.expect(res.pagination).to.have.property('total'));",
                  "pm.test('prices are plain numbers, not $numberDecimal', () => {",
                  "  (res.data || []).forEach((p) => {",
                  "    pm.expect(typeof p.defaultUnitPrice, p.code).to.eql('number');",
                  "  });",
                  "});",
                  "if (res.data && res.data[0]) {",
                  "  pm.collectionVariables.set('productId', res.data[0]._id);",
                  "}"
                ]
              }
            }
