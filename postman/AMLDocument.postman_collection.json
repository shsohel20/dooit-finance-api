    {
      "name": "6. Generation History (PolicyHubTemplate)",
      "item": [
        {
          "name": "History — All AML docs for a Client",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('success', () => pm.expect(res.success).to.be.true);",
                  "if (res.data && res.data.length > 0) {",
                  "  pm.collectionVariables.set('policyHubTemplateId', res.data[0]._id);",
                  "  console.log('policyHubTemplateId set:', res.data[0]._id);",
                  "  console.log('docs found:', res.data.length);",
                  "  res.data.forEach(d => console.log(' -', d.name, '|', d.generatedFileUrl));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{URL}}/api/v1/policy-hub-templates?client={{clientId}}&sort=-createdAt&limit=20",
              "host": ["{{URL}}"],
              "path": ["api", "v1", "policy-hub-templates"],
              "query": [
                { "key": "client", "value": "{{clientId}}" },
                { "key": "sort", "value": "-createdAt" },
                { "key": "limit", "value": "20" },
                { "key": "sourceTemplateConfig", "value": "", "disabled": true, "description": "Optionally filter by specific template" }
              ]
            },
            "description": "Returns all PolicyHubTemplate records for a client that were generated by the AML doc-gen system. Each record has generatedFileUrl (download link) and generatedSnapshotData (AML 7-yr audit snapshot)."
          },
          "response": []
        },
        {
          "name": "History — Filter by TemplateConfig",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{URL}}/api/v1/policy-hub-templates?client={{clientId}}&sourceTemplateConfig={{templateConfigId}}&sort=-createdAt",
              "host": ["{{URL}}"],
              "path": ["api", "v1", "policy-hub-templates"],
              "query": [
                { "key": "client", "value": "{{clientId}}" },
                { "key": "sourceTemplateConfig", "value": "{{templateConfigId}}" },
                { "key": "sort", "value": "-createdAt" }
              ]
            },
            "description": "History for a specific template (e.g. all Lawyers program versions for this client)."
          },
