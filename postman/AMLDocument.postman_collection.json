{
  "info": {
    "name": "AML Document Generation",
    "description": "Template listing, on-demand .docx generation, and history for AUSTRAC AML/CTF compliance documents. Covers all 9 entity-type templates (Tranche 1 & 2). Generated files are uploaded to FileVault and saved as PolicyHubTemplate records for 7-year AML retention.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "URL",
      "value": "http://localhost:6830",
      "type": "string"
    },
    {
      "key": "token",
      "value": "PASTE_YOUR_JWT_TOKEN_HERE",
      "type": "string"
    },
    {
      "key": "clientId",
      "value": "",
      "type": "string",
      "description": "Client ObjectId — set this to the client you want to generate docs for"
    },
    {
      "key": "templateConfigId",
      "value": "",
      "type": "string",
      "description": "TemplateConfig ObjectId — auto-set by List Templates test script"
    },
    {
      "key": "policyHubTemplateId",
      "value": "",
      "type": "string",
      "description": "PolicyHubTemplate ObjectId — auto-set by generation test scripts"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Templates",
      "item": [
        {
          "name": "List All Active Templates",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('success', () => pm.expect(res.success).to.be.true);",
                  "pm.test('returns array', () => pm.expect(res.data).to.be.an('array'));",
                  "if (res.data && res.data.length > 0) {",
                  "  pm.collectionVariables.set('templateConfigId', res.data[0]._id);",
                  "  console.log('templateConfigId set:', res.data[0]._id);",
                  "  console.log('Available templateKeys:', res.data.map(t => t.templateKey).join(', '));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{URL}}/api/v1/aml-document/templates",
              "host": ["{{URL}}"],
              "path": ["api", "v1", "aml-document", "templates"]
            },
            "description": "Returns all active TemplateConfig documents with their eligibleTypes and variableMap."
          },
          "response": []
        },
        {
          "name": "Filter Templates — Lawyers & Conveyancers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('success', () => pm.expect(res.success).to.be.true);",
                  "if (res.data && res.data.length > 0) {",
                  "  pm.collectionVariables.set('templateConfigId', res.data[0]._id);",
                  "  console.log('templateConfigId set:', res.data[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{URL}}/api/v1/aml-document/templates?entityTypeName=Tranche 2 - Lawyers%2FConveyancers",
              "host": ["{{URL}}"],
              "path": ["api", "v1", "aml-document", "templates"],
              "query": [
                { "key": "entityTypeName", "value": "Tranche 2 - Lawyers/Conveyancers" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Filter Templates — Accountants",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{URL}}/api/v1/aml-document/templates?entityTypeName=Tranche 2 - Accountants",
              "host": ["{{URL}}"],
              "path": ["api", "v1", "aml-document", "templates"],
              "query": [
                { "key": "entityTypeName", "value": "Tranche 2 - Accountants" }
              ]
            }
          },
          "response": []
