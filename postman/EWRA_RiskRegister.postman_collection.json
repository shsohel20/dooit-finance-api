    {
      "name": "Risk Register — Workflow",
      "item": [
        {
          "name": "Submit for Review (Draft → In Review)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Status is In Review', () => pm.expect(body.data.status).to.equal('In Review'));",
                  "pm.test('submittedAt set', () => pm.expect(body.data.submittedAt).to.be.a('string'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/risk-register/{{registerId}}/submit",
              "host": ["{{baseUrl}}"],
              "path": ["risk-register", "{{registerId}}", "submit"]
            }
