              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Has entity name', () => pm.expect(body.data.entityName).to.be.a('string').and.not.empty);",
