        },
        {
          "name": "Approve Register (In Review → Approved)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Status is Approved', () => pm.expect(body.data.status).to.equal('Approved'));",
                  "pm.test('approvedAt set', () => pm.expect(body.data.approvedAt).to.be.a('string'));"
                ],
                "type": "text/javascript"
