    {
      "name": "Risk Register — Scenario Patches",
      "item": [
        {
          "name": "Patch Scenario — C-002 manual L/C override",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('manualL stored', () => pm.expect(body.data.row.manualL).to.equal(4));",
                  "pm.test('Summary refreshed', () => pm.expect(body.data.summary.rowCount).to.be.above(0));",
                  "console.log('C-002 residual after patch:', body.data.row.residualRiskLabel);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"L\": 4,\n  \"C\": 4,\n  \"ctrlEff\": 3,\n  \"reviewerNotes\": \"Reviewed by Robert Chen 2026-06-17. HVC trust structures with multiple layers observed. L raised from 3 to 4 to reflect actual risk profile.\",\n  \"status\": \"Reviewed\"\n}"
            },
