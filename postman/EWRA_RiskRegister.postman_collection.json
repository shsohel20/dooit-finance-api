          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/risk-register?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["risk-register"],
              "query": [
                { "key": "page",       "value": "1" },
                { "key": "limit",      "value": "20" },
                { "key": "status",     "value": "Draft",                "disabled": true },
                { "key": "entityType", "value": "Lawyers/Conveyancers", "disabled": true },
                { "key": "entityName", "value": "Smith",                "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Has rows array', () => pm.expect(body.data.rows).to.be.an('array').that.is.not.empty);",
                  "pm.test('Entity name matches', () => pm.expect(body.data.entityName).to.be.a('string'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/risk-register/{{registerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["risk-register", "{{registerId}}"]
            }
          }
        },
        {
          "name": "Get by Entity Name",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Has rows', () => pm.expect(body.data.rows).to.be.an('array').that.is.not.empty);",
                  "pm.test('Entity name matches (case-insensitive)', () => {",
                  "  pm.expect(body.data.entityName.toLowerCase()).to.include('smith');",
                  "});",
                  "console.log('Found register:', body.data.entityName, '| Status:', body.data.status, '| Rows:', body.data.rowCount);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/risk-register/by-entity/Smith & Associates Lawyers Pty Ltd",
              "host": ["{{baseUrl}}"],
              "path": ["risk-register", "by-entity", "Smith & Associates Lawyers Pty Ltd"]
            },
            "description": "Returns the most recently created register for the given entity name. Match is case-insensitive and exact (anchored). Returns full register including all rows."
          }
        },
        {
