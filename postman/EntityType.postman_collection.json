                  "if (res.success) {",
                  "  pm.collectionVariables.set('entityTypeId', '');",
                  "  console.log('entityTypeId cleared after delete');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{URL}}/api/v1/entity-type/{{entityTypeId}}",
              "host": ["{{URL}}"],
              "path": ["api", "v1", "entity-type", "{{entityTypeId}}"]
            },
            "description": "Permanently deletes and clears {{entityTypeId}}. Cache is automatically invalidated."
          },
          "response": []
        }
      ]
