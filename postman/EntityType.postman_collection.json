{
  "info": {
    "name": "Entity Type",
    "description": "CRUD for EntityType — the 10 AUSTRAC-regulated entity types across Tranche 1 and Tranche 2. Includes matchKeywords management for the dynamic entity type resolver.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "URL",
      "value": "http://localhost:6830",
      "type": "string"
    },
    {
      "key": "token",
      "value": "PASTE_YOUR_JWT_TOKEN_HERE",
      "type": "string"
    },
    {
      "key": "entityTypeId",
      "value": "",
      "type": "string",
      "description": "Auto-set by any Create request test script, or paste a real ObjectId"
    }
  ],
  "item": [
    {
      "name": "List & Get",
      "item": [
        {
          "name": "Get All Entity Types",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{URL}}/api/v1/entity-type",
              "host": ["{{URL}}"],
              "path": ["api", "v1", "entity-type"]
            },
            "description": "Returns all active entity types sorted by category then name."
          },
          "response": []
        },
        {
          "name": "Get All — Tranche 1 Only",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{URL}}/api/v1/entity-type?category=Tranche 1",
              "host": ["{{URL}}"],
              "path": ["api", "v1", "entity-type"],
              "query": [
                { "key": "category", "value": "Tranche 1", "description": "Banks, Remittance, VASP, Gambling, Insurance" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get All — Tranche 2 Only",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{URL}}/api/v1/entity-type?category=Tranche 2",
              "host": ["{{URL}}"],
              "path": ["api", "v1", "entity-type"],
              "query": [
                { "key": "category", "value": "Tranche 2", "description": "Lawyers, Accountants, Real Estate, PMD, TCSPs — obligations commence 1 July 2026" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Single Entity Type",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{URL}}/api/v1/entity-type/{{entityTypeId}}",
              "host": ["{{URL}}"],
              "path": ["api", "v1", "entity-type", "{{entityTypeId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Create — Tranche 1",
      "item": [
        {
          "name": "Create — Banks & ADIs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data._id) {",
                  "  pm.collectionVariables.set('entityTypeId', res.data._id);",
                  "  console.log('entityTypeId set to:', res.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Banks & ADIs\",\n  \"category\": \"Tranche 1\",\n  \"description\": \"Authorised Deposit-taking Institutions — banks, credit unions, building societies, mutual banks, and neobanks regulated under the Banking Act 1959.\",\n  \"riskModelRef\": \"RISK_MODEL_BANK\",\n  \"matchKeywords\": [\"bank\", \"adi\", \"adis\", \"credit union\", \"building society\", \"mutual bank\", \"financial institution\", \"financial\", \"neobank\", \"authorised deposit\"],\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{URL}}/api/v1/entity-type",
              "host": ["{{URL}}"],
              "path": ["api", "v1", "entity-type"]
            },
            "description": "matchKeywords includes 'financial' so clientType values like 'Financial', 'Financial Institution', or 'Financial Services' all resolve to this entity type."
          },
          "response": []
        },
