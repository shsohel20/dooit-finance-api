    {
      "name": "Update",
      "item": [
        {
          "name": "Update — Name & Description",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Banks & ADIs\",\n  \"description\": \"Updated description.\",\n  \"riskModelRef\": \"RISK_MODEL_BANK_V2\"\n}"
            },
            "url": {
              "raw": "{{URL}}/api/v1/entity-type/{{entityTypeId}}",
              "host": ["{{URL}}"],
              "path": ["api", "v1", "entity-type", "{{entityTypeId}}"]
            },
            "description": "Cache is automatically invalidated after update."
          },
          "response": []
        },
        {
          "name": "Update — matchKeywords (Banks & ADIs example)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"matchKeywords\": [\"bank\", \"adi\", \"adis\", \"credit union\", \"building society\", \"mutual bank\", \"financial institution\", \"financial\", \"neobank\", \"authorised deposit\"]\n}"
            },
            "url": {
              "raw": "{{URL}}/api/v1/entity-type/{{entityTypeId}}",
              "host": ["{{URL}}"],
              "path": ["api", "v1", "entity-type", "{{entityTypeId}}"]
            },
            "description": "Replace the matchKeywords array. 'financial' is included so clientType values like 'Financial', 'Financial Institution', or 'Financial Services' all resolve to Banks & ADIs. Cache is automatically cleared."
          },
          "response": []
        },
        {
          "name": "Update — Deactivate",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": false\n}"
            },
            "url": {
              "raw": "{{URL}}/api/v1/entity-type/{{entityTypeId}}",
              "host": ["{{URL}}"],
              "path": ["api", "v1", "entity-type", "{{entityTypeId}}"]
            },
            "description": "Deactivated types are excluded from GET responses and from the resolver cache."
          },
          "response": []
        }
