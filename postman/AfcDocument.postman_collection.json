                  "  pm.collectionVariables.set('afcDocumentId', res.data._id);",
                  "  console.log('afcDocumentId set:', res.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_path\": \"/app/output/fintech/TechFlow_Financial_Pty_Ltd/risk_management_policy_v1.md\",\n  \"content_md\": \"# Risk Management Policy\\n\\n## Purpose\\nThis policy outlines risk management procedures...\",\n  \"content_b64\": \"\",\n  \"metadata\": {\n    \"company\": \"TechFlow Financial Pty Ltd\",\n    \"industry\": \"fintech\",\n    \"document_type\": \"risk_management_policy\",\n    \"compliance_officer\": \"Sarah Johnson\",\n    \"version\": 1,\n    \"model\": \"qwen3-vl:235b-cloud\",\n    \"generated_at\": \"2026-05-19T06:10:12.942314\"\n  },\n  \"status\": \"completed\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{URL}}/api/v1/afc-documents/new",
