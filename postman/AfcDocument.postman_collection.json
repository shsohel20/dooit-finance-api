{
  "info": {
    "name": "AFC Documents",
    "description": "Full CRUD, import/export (.docx & PDF), and AI webhook upsert for AFC documents (collection: afc-documents).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "URL",
      "value": "http://localhost:6830",
      "type": "string"
    },
    {
      "key": "token",
      "value": "PASTE_YOUR_JWT_TOKEN_HERE",
      "type": "string"
    },
    {
      "key": "afcDocumentId",
      "value": "",
      "type": "string",
      "description": "AfcDocument ObjectId — auto-set by Create / Import requests"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
